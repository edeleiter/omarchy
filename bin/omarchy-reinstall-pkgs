#!/bin/bash

# omarchy:summary=Reinstall all default Omarchy packages from the stable channel
# omarchy:requires-sudo=true

set -e

# Reinstall all default Omarchy packages from the stable channel and downgrade any packages that are too new.

# Set the package repository to the stable mirrors
omarchy-refresh-pacman

# Downgrade any packages to the stable setup
sudo env OMARCHY_UPDATE_PACMAN=1 pacman -Suu --noconfirm

# Ensure all packages are installed
source "$OMARCHY_PATH/install/helpers/packages.sh"
mapfile -t packages < <(resolve_packages "$OMARCHY_PATH/install/omarchy-base.packages")

# Without this guard an empty list turns the pacman call below into `pacman -Syu` with no
# package arguments: a silent unattended full-system upgrade instead of an error.
if (( ${#packages[@]} == 0 )); then
  echo "No packages resolved from $OMARCHY_PATH/install/omarchy-base.packages" >&2
  exit 1
fi

sudo env OMARCHY_UPDATE_PACMAN=1 pacman -Syu --noconfirm --needed "${packages[@]}"
